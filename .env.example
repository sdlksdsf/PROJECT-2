# Copy to .env and fill in what you use. Everything here is optional —
# Kimmino has no server of its own and works fully offline without any of it.

# ---------------------------------------------------------------- sync (opt-in)
# Your own Supabase project. See docs/SYNC.md for the schema and RLS policies.
KIMMINO_SUPABASE_URL=
KIMMINO_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------ AI (opt-in)
# Any OpenAI-compatible chat-completions endpoint. Requests go from your machine
# to your provider; Kimmino never proxies them.
KIMMINO_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
KIMMINO_AI_MODEL=gpt-4o-mini
KIMMINO_AI_KEY=

# ------------------------------------------------------------------ development
# Open devtools for the shell on launch.
KIMMINO_DEVTOOLS=0
