# Copy to .env and fill in what you use. Everything here is optional —
# Kimmino works fully offline without any of it.

# ---------------------------------------------------------------- sync (opt-in)
# The desktop build already points at the Kimmino Supabase project with a
# publishable key. Set these only to run your own (see docs/SYNC.md).
KIMMINO_SUPABASE_URL=
KIMMINO_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------ AI (opt-in)
# The assistant talks to api/ai.ts, which holds the provider keys. Deploy it to
# Vercel and set the keys there — never in this file, never in the installer.
GEMINI_API_KEY=
GROQ_API_KEY=
# Point the desktop app at a different proxy (defaults to
# https://kimmino.vercel.app/api/ai).
KIMMINO_AI_URL=

# ------------------------------------------------------------------ development
# Open devtools for the shell on launch.
KIMMINO_DEVTOOLS=0
