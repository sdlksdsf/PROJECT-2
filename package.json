{
  "name": "kimmino",
  "version": "1.1.0",
  "private": true,
  "description": "Kimmino \u2014 a fast, private, open-source browser.",
  "license": "MPL-2.0",
  "author": "Kimmino Contributors",
  "homepage": "https://kimmino.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/sdlksdsf/PROJECT-2.git"
  },
  "workspaces": [
    "browser",
    "website"
  ],
  "scripts": {
    "dev": "npm run dev --workspace browser",
    "dev:ui": "npm run dev:ui --workspace browser",
    "dev:web": "npm run dev --workspace website",
    "build": "npm run build --workspace browser",
    "build:site": "npm run build --workspace website",
    "typecheck": "npm run typecheck --workspace browser && npm run typecheck --workspace website",
    "test": "npm run test --workspace browser",
    "package": "npm run package --workspace browser",
    "screenshots": "node tools/render-screenshots.mjs",
    "filters": "node tools/build-filters.mjs",
    "icons": "node tools/render-icon.mjs",
    "fonts": "bash tools/fonts-setup.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
